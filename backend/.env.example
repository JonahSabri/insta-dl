DATABASE_URL=sqlite+aiosqlite:///./instadb.sqlite
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=true
# یک آدرس یا چند آدرس جدا با ویرگول:
ALLOWED_ORIGINS=http://localhost:3000
# چند آدرس: ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_EXPIRE_MINUTES=480

GUEST_DAILY_LIMIT=3
FILE_CLEANUP_MINUTES=30

INSTAGRAM_COOKIES_FILE=

# Proxy (optional) — e.g. http://127.0.0.1:10809  or  socks5://127.0.0.1:1080
HTTP_PROXY=
HTTPS_PROXY=

# GapGPT — auto-translate articles to all languages
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-5.2
